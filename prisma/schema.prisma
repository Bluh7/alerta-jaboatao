generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncidentCategory {
  robbery
  incident
  police
  homicide
  disorder
  noise
  fight
  mass_robbery
  protest
  dangerous_animals
  vehicle_dismantling
  drug_trafficking
  drug_use
  bus_fire
  bus_robbery
  kidnapping
  bank_explosion
  other
}

model Incident {
  id          String           @id @default(uuid())
  category    IncidentCategory
  lat         Float
  lng         Float
  description String
  createdAt   DateTime         @default(now())
  ownerId     String?
  likes       IncidentLike[]
  messages    IncidentMessage[]
  ignoredBy   IgnoredIncident[]
}

model IncidentLike {
  incidentId String
  viewerId   String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@id([incidentId, viewerId])
}

model IncidentMessage {
  id         String   @id @default(uuid())
  incidentId String
  viewerId   String
  text       String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model IgnoredIncident {
  incidentId String
  viewerId   String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@id([incidentId, viewerId])
}
